# Core API settings
MONGO_URI=mongodb://127.0.0.1:27017/event_invitation
PORT=5000
FRONTEND_URL=http://localhost:5173
DEFAULT_EVENT_SLUG=main-event

# Admin authentication
ADMIN_KEY=x-admin-key
ADMIN_JWT_SECRET=dev-admin-secret
ADMIN_JWT_EXPIRES=12h

# Initial organizer seed (dev convenience)
SEED_ADMIN_EMAIL=organizer@example.com
SEED_ADMIN_PASSWORD=organizer123
SEED_ADMIN_NAME=Event Organizer

# SMTP (optional for email sending)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=secret
SMTP_SECURE=false
EMAIL_FROM="Event Bot" <no-reply@example.com>